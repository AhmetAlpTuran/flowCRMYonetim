# Edge Function secrets. Copy to supabase/functions/.env (git-ignored) for local
# `supabase functions serve --env-file supabase/functions/.env`, or set them on a
# hosted project with `supabase secrets set --env-file <file>`.
# Never put any of these in Flutter configuration.

# --- Supabase ---------------------------------------------------------------
# Local values are printed by `supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SERVICE_ROLE_KEY=

# --- Meta app (this SaaS's own app, not a customer's) -------------------------
META_APP_ID=
META_APP_SECRET=
# Chosen explicitly at deployment; there is no fallback. Example: v23.0
WHATSAPP_API_VERSION=
# Webhook verify token, 32-256 characters: openssl rand -hex 32
WHATSAPP_WEBHOOK_TOKEN=

# --- Per-tenant token encryption (AES-256-GCM) ------------------------------
# JSON map of key id -> base64 32-byte key: openssl rand -base64 32
WHATSAPP_CREDENTIAL_KEYS={"primary-v1":"<base64 key>"}
WHATSAPP_CREDENTIAL_ACTIVE_KEY=primary-v1

# --- Worker authentication, 32-256 characters each: openssl rand -hex 32 -----
# The same values go into Vault for supabase/ops/schedule_*.sql.
WEBHOOK_WORKER_SECRET=
INBOX_WORKER_SECRET=
CAMPAIGN_WORKER_SECRET=
BOT_WORKER_SECRET=
MEDIA_WORKER_SECRET=
KNOWLEDGE_WORKER_SECRET=
# For uptime monitors calling the health function (docs/OPERATIONS.md).
HEALTH_CHECK_SECRET=

# --- AI ---------------------------------------------------------------------
OPENAI_API_KEY=
# Comma-separated allowlist offered to tenants.
OPENAI_ALLOWED_MODELS=gpt-4o-mini
# Monthly token cap for businesses without a subscription; plans set their own
# allowance (docs/BILLING.md). Must be a valid number for the bot worker to run.
AI_MONTHLY_TOKEN_LIMIT=1000000
# Embeddings for knowledge search (1536 dimensions); "off" uses full-text search only.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Billing (iyzico subscriptions, docs/BILLING.md) -------------------------
# Sandbox keys from https://sandbox-merchant.iyzipay.com; production from the merchant panel.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_MERCHANT_ID=
# https://sandbox-api.iyzipay.com (default) or https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# The static payment page (docs/odeme on GitHub Pages).
BILLING_PAGE_URL=https://ahmetalpturan.github.io/flowCRMYonetim/odeme/
# Public functions URL; defaults to SUPABASE_URL + /functions/v1.
PUBLIC_FUNCTIONS_URL=
